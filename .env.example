# ==============================================================================
# KisanMitra Agri Market Linkage Platform - Environment Configuration
# ==============================================================================

# Application Configuration
PROJECT_NAME="Agri Market Linkage Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # development | production | testing
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
FRONTEND_URL="http://localhost:3000"

# Clerk identity (server-only; never expose CLERK_SECRET_KEY to the browser)
CLERK_SECRET_KEY="sk_test_your-clerk-secret-key"
CLERK_ISSUER="https://your-instance.clerk.accounts.dev"
CLERK_JWKS_URL="https://your-instance.clerk.accounts.dev/.well-known/jwks.json"

# Supabase Project Credentials
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
# Used by Frontend & FastAPI for public operations
SUPABASE_ANON_KEY="your-supabase-anon-key"
# Used by FastAPI backend for admin/storage/privileged operations (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Used for offline/local JWT verification (Supabase Dashboard -> Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# PostgreSQL Database Connection String
# Used by SQLAlchemy and Alembic migrations.
# In Supabase: Project Settings -> Database -> Connection string (URI) -> Transaction Pooler / Direct connection
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres (or direct 5432)
# Example for local development with SQLite fallback: sqlite:///./kisanmitra.db
DATABASE_URL="postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres"

# Optional official mandi-feed configuration. These values must stay server-side.
MANDI_API_URL=""
MANDI_API_KEY=""

# Supabase Storage Buckets
STORAGE_BUCKET_DOCUMENTS="documents"
STORAGE_BUCKET_PRODUCE="produce-images"
STORAGE_BUCKET_PROFILES="profile-images"

# Chatbot — Local LLM (SIH2026 local-first, no API bill)
# Swap without code change: qwen3:8b | sarvam-2b | bharatgenai/AgriParam GGUF via Ollama
ASSISTANT_MODEL="qwen3:8b"
OLLAMA_HOST="http://localhost:11434"
BHASHINI_USER_ID=""
BHASHINI_API_KEY=""
